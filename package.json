{
  "name": "bookmark-freshness-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "postinstall": "wxt prepare",
    "build": "npm run build:site",
    "build:extension": "wxt build && wxt zip",
    "build:site": "npm run build:extension && node scripts/stage-extension.mjs && vite build --config site/vite.config.ts",
    "test": "npm run lint && npm run build && vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/verify-claims.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.5.2",
    "@fontsource/archivo-black": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@axe-core/playwright": "4.10.2",
    "@types/chrome": "0.1.32",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  }
}
